# Copy to .env.local and adjust. Never commit .env.local.

# Database.
# Locally, after `docker compose up -d`:
DATABASE_URL="postgresql://ardoise:ardoise@localhost:5433/ardoise"
# In production: the connection string from the managed Postgres provider
# (EU region), in its pooled form.

# Salt used to hash IP addresses in the login_attempts table.
# Generate a unique value:  openssl rand -base64 32
IP_HASH_SECRET="replace-with-a-random-32-byte-value"

# Pepper mixed into PINs before hashing. It never reaches the database, which
# is what prevents four-digit codes being cracked if the database ever leaks.
# Generate:  openssl rand -base64 32
# WARNING: changing it invalidates every existing PIN.
PIN_PEPPER="replace-with-a-random-32-byte-value"
